{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "docker build . --file Dockerfile --tag ghcr.io/web3-plurality/plurality-market-ai-service-pre:latest --tag ghcr.io/web3-plurality/plurality-market-ai-service-pre:${nextRelease.version}",
        "publishCmd": "for i in 1 2 3; do docker push ghcr.io/web3-plurality/plurality-market-ai-service-pre:latest && docker push ghcr.io/web3-plurality/plurality-market-ai-service-pre:${nextRelease.version} && exit 0; echo \"push attempt $i failed, retrying in 20s\"; sleep 20; done; exit 1",
        "successCmd": "echo \"version=${nextRelease.version}\" >> $GITHUB_OUTPUT"
      }
    ],
    "@semantic-release/github"
  ],
  "tagFormat": "v${version}"
}
