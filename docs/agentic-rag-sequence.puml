@startuml Agentic RAG Sequence Diagram

!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Client
participant "API Endpoint\n/agentic-rag-query" as API
participant "ContextService" as ContextSvc
participant "AgenticRAGService\n(LangGraph)" as AgenticRAG
participant "VectorService" as VectorSvc
participant "HuggingFace\nEmbeddings\n(BGE)" as Embeddings
participant "LLM\n(Gemini)" as LLM
database "S3 Vector\nDatabase" as VectorDB

== Request Phase ==
Client -> API: POST /rag/agentic-rag-query\n(query, userId, profileId,\nchatHistory, contextSummary)
API -> API: validate_api_key()
API -> ContextSvc: agentic_rag_query(query_request)

== Workflow Initialization ==
ContextSvc -> AgenticRAG: process_rag_query()
AgenticRAG -> AgenticRAG: initialize_node()\n[Set default state]

== Query Detection & Analysis ==
AgenticRAG -> AgenticRAG: detect_pluto_query_node()\n[Check for @pluto prefix]
alt @pluto query detected
    AgenticRAG -> AgenticRAG: Strip @pluto prefix
    note right: Route to pluto_flow
else normal query
    AgenticRAG -> AgenticRAG: analyze_query_node()
    AgenticRAG -> LLM: Classify query type\n(simple/vague/conversational/complex)
    LLM --> AgenticRAG: query_type, needs_expansion\n[Track tokens]
    note right: Route to normal_flow
end

== Chat History Optimization ==
AgenticRAG -> AgenticRAG: optimize_chat_history_node()
AgenticRAG -> LLM: Optimize chat history\n(max 4000 tokens)
LLM --> AgenticRAG: chat_history_text\n[Track tokens]

== Query Separation ==
AgenticRAG -> AgenticRAG: separate_query_data_node()
AgenticRAG -> LLM: Separate query from data
LLM --> AgenticRAG: separated_query, separated_data\n[Track tokens]

== Conditional Query Expansion ==
alt Vague Query (no profileId or no docs)
    AgenticRAG -> AgenticRAG: expand_vague_query_node()
    AgenticRAG -> LLM: Enhance query using context summary\nand chat history
    LLM --> AgenticRAG: enhanced_query\n[Track tokens]
end

== Context Retrieval ==
alt Has profileId
    AgenticRAG -> AgenticRAG: retrieve_contexts_node()
    AgenticRAG -> Embeddings: embed_text(query)\n[BAAI/bge-large-en-v1.5]
    Embeddings --> AgenticRAG: query_vector (1024 dimensions)
    AgenticRAG -> VectorSvc: query_vectors(query_vector, k, filters)
    VectorSvc -> VectorDB: Search similar vectors\n(userId, profileId filters)
    VectorDB --> VectorSvc: relevant_vectors
    VectorSvc --> AgenticRAG: relevant_docs
    AgenticRAG -> AgenticRAG: Sort & combine context\n[get_chunk_sort_key]
else No profileId
    note over AgenticRAG: Skip retrieval
end

== Context Relevance Check ==
alt Has context retrieved
    AgenticRAG -> AgenticRAG: check_relevance_node()
    AgenticRAG -> LLM: Check context relevance\nto query
    LLM --> AgenticRAG: context_is_relevant, relevant_context\n[Track tokens]
else No context
    note over AgenticRAG: Skip relevance check
end

== Language Detection ==
AgenticRAG -> AgenticRAG: detect_language_node()
AgenticRAG -> LLM: Detect query language
LLM --> AgenticRAG: language (e.g., 'en', 'ur', 'ar')\n[Track tokens]

== Prompt Generation ==
alt @pluto query
    AgenticRAG -> AgenticRAG: generate_direct_answer_node()
    AgenticRAG -> LLM: Generate direct answer\n(context + query)
    LLM --> AgenticRAG: direct_answer\n[Track tokens]
else Normal query
    AgenticRAG -> AgenticRAG: generate_prompt_node()
    AgenticRAG -> LLM: Generate optimized prompt\n(query, context, data, language,\nattachContextSummary, platform)
    LLM --> AgenticRAG: optimized_prompt\n[Track tokens]
end

== Response Assembly ==
AgenticRAG --> ContextSvc: Return workflow result\n{query, optimized_prompt/direct_answer,\ncontext, sources, tokens_used,\nworkflow_metadata}
ContextSvc --> API: RAG query response
API --> Client: 200 OK\n{optimized_prompt, context,\nsources, workflow_metadata,\ntokens_used}

@enduml
