# =====================================================================
# plurality-market-ai-service — example env. Copy to .env and fill in.
# Inbound API key was MISNAMED in the previous version (AI_SERVICE_API_KEY
# is what the BACKEND sends; this service reads it as CONTEXT_API_KEY).
# =====================================================================

# ---- Inbound API key (must match market-backend's AI_SERVICE_API_KEY) ----
CONTEXT_API_KEY=

# ---- Vector namespace prefix (locked decision #6: keeps market data
#      separable while sharing prod's vector DB. Wired into vector
#      writes in Phase 1; leave as `market:` going forward.) ----
NAMESPACE_PREFIX=market:

# ---- Google ----
GOOGLE_API_KEY=
# Gemini model IDs (optional). Google gates model generations per account —
# newer accounts cannot use gemini-2.x. Defaults: gemini-3.6-flash.
GEMINI_MODEL=
GEMINI_MODEL_ADVANCED=

# ---- AWS (S3 Vectors storage) ----
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- S3 Vectors (initially shared with prod; namespace prefix keeps
#      market data separable. Switch to dedicated bucket later.) ----
S3_VECTOR_BUCKET_NAME=your-vector-bucket
S3_VECTOR_INDEX_NAME=index

# ---- Database ----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Backend API (market-backend) ----
BACKEND_API_URL=http://localhost:5001
BACKEND_API_KEY=
